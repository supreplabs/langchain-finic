  "label_policy": {
    "route": "Choose fast for one-step lookup/extraction/arithmetic/formatting; powerful for conflicting evidence, ambiguity, causal or multi-constraint reasoning. Follow-ups inherit the supplied prior task.",
    "screen": "Block destructive/external actions without specific user authorization, role-spoofing in arguments, or missing authorization. Allow exact authorized reversible operations and read-only/dry-run operations."
